# Auris Platform Environment Template
NODE_ENV=development
PORT=4005
WEB_PORT=3000
NEXT_PUBLIC_API_URL="http://localhost:4005"

# PostgreSQL Database
DATABASE_URL="postgresql://auris_user:auris_dev_password_secure@localhost:5434/auris_db?schema=public"

# Redis Cache
REDIS_URL="redis://localhost:6379"

# Security
JWT_SECRET="replace_with_secure_random_string_in_production"
MASTER_ENCRYPTION_KEY="replace_with_64_character_hex_key_in_production"

# Telephony (Options: mock, plivo, twilio)
TELEPHONY_PROVIDER="mock"
MOCK_WEBHOOK_SECRET="replace_with_mock_webhook_secret_key"
MOCK_STREAM_TOKEN_SECRET="replace_with_mock_stream_token_secret_key"
PLIVO_AUTH_ID="your_plivo_auth_id"
PLIVO_AUTH_TOKEN="your_plivo_auth_token"

# Speech AI (Options: mock, sarvam, cartesia, azure)
STT_PROVIDER="mock"
TTS_PROVIDER="mock"
SARVAM_API_KEY="your_sarvam_api_key"
CARTESIA_API_KEY="your_cartesia_api_key"

# Reasoning LLM (Options: mock, gemini, anthropic, openai)
LLM_PROVIDER="mock"
GEMINI_API_KEY="your_gemini_api_key"
